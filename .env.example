# Copy to apps/api/.env and adjust. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/careerradar
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# 32 random bytes, base64. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

MAIL_FROM="CareerRadar <no-reply@careerradar.local>"
SMTP_URL=smtp://localhost:1025

# Used by `pnpm seed:admin`
ADMIN_EMAIL=admin@careerradar.local
ADMIN_PASSWORD=
