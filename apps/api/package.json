{
  "name": "@careerradar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup src/server.ts src/scripts/seedAdmin.ts --format esm --clean --sourcemap",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:admin": "tsx --env-file-if-exists=.env src/scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@careerradar/shared": "workspace:^",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5",
    "express-rate-limit": "^7",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8",
    "nodemailer": "^10.6.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsup": "^8",
    "tsx": "^4.23.15",
    "vitest": "^2"
  }
}
